// Statements
set_stmt: T_KW_SET T_IDENTIFIER T_OP_ASSGN expr

expr: primary_expr 
    | member_expr

primary_expr: T_IDENTIFIER 
    | T_KW_NOTHING 
    | T_KW_TRUE
    | T_KW_FALSE
    | T_INT
    | T_STRING_LITERAL

member_expr: primary_expr T_PUNCT_DOT T_IDENTIFIER
    | primary_expr T_PUNCT_DOT call_expr

call_expr: T_IDENTIFIER T_PUNCT_LPAREN args T_PUNCT_RPAREN

args: expr (T_PUNCT_COMMA expr)*
    |   // empty

