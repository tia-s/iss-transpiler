%import common.ESCAPED_STRING -> T_STRING_LITERAL
%import common.INT -> T_INT
%import common.WS
%import common.CNAME -> T_IDENTIFIER

%ignore WS

// start: (T_COMMENT | stmt_var_assgn | stmt_var_decl | sub_main | fn | loop_for)*
start: (T_COMMENT | set_stmt)*

T_COMMENT: /'[^\n]*/

// Operators
T_OP_LSHIFT_ASSGN: "<<="
T_OP_RSHIFT_ASSGN: ">>="
T_OP_INT_DIV_ASSGN: "\="
T_OP_CONCAT_ASSGN: "&="
T_OP_EXP_ASSGN: "^="
T_OP_MUL_ASSGN: "*="
T_OP_DIV_ASSGN: "/="
T_OP_ADD_ASSGN: "+="
T_OP_SUB_ASSGN: "-="
T_OP_LSHIFT: "<<"
T_OP_RSHIFT: ">>"
T_OP_LTE: "<="
T_OP_GTE: ">="
T_OP_NEQ: "<>"
T_OP_ASSGN: "="
T_OP_CONCAT: "&"
T_OP_EXP: "^"
T_OP_MUL: "*"
T_OP_DIV: "/"
T_OP_ADD: "+"
T_OP_SUB: "-"
T_OP_LT: "<"
T_OP_GT: ">"

// Punctuators and Special Characters
T_PUNCT_AT: "@"
T_PUNCT_BACKSLASH: /\\/
T_PUNCT_BACKTICK: "`"
T_PUNCT_COLON: ":"
T_PUNCT_COMMA: ","
T_PUNCT_DOLLAR: "$"
T_PUNCT_DOT: "."
T_PUNCT_EXCLAMATION: "!"
T_PUNCT_HASH: "#"
T_PUNCT_LBRACE: "{"
T_PUNCT_LBRACK: /\[/
T_PUNCT_LPAREN: "("
T_PUNCT_PERCENT: "%"
T_PUNCT_PIPE: "|"
T_PUNCT_QUESTION: "?"
T_PUNCT_RBRACE: "}"
T_PUNCT_RBRACK: /\]/
T_PUNCT_RPAREN: ")"
T_PUNCT_SEMICOLON: ";"
T_PUNCT_TILDE: "~"
T_PUNCT_UNDERSCORE: "_"

// Reserved Keywords
T_KW_GETXMLNAMESPACE.2: /GETXMLNAMESPACE/i
T_KW_NOTINHERITABLE.2: /NOTINHERITABLE/i
T_KW_NOTOVERRIDABLE.2: /NOTOVERRIDABLE/i
